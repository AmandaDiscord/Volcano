{
	"name": "volcano-server",
	"version": "2.0.0",
	"description": "A light-weight LavaLink compatible replacement",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc && node -e \"require('node:fs').cpSync('public', 'dist', { recursive: true })\"",
		"start": "node --enable-source-maps --optimize_for_size .",
		"create-release": "node ./scripts/release.js",
		"dep-report": "node ./scripts/generateDependencyReport.js"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AmandaDiscord/Volcano.git"
	},
	"keywords": [
		"discord",
		"voice",
		"lavalink",
		"light-weight",
		"modular",
		"volcano"
	],
	"author": "PapiOphidian",
	"license": "MIT",
	"dependencies": {
		"@discordjs/voice": "^0.19.2",
		"backtracker": "^5.1.1",
		"html-entities": "^2.6.0",
		"libsodium-wrappers": "0.8.4",
		"m3u8stream": "github:AmandaDiscord/node-m3u8stream#bd85c3133f6c74a01880481e1446b726d7cf5e7b",
		"music-metadata": "^12.2.1",
		"node-av": "^6.1.1",
		"node-html-parser": "^9.0.4",
		"twitch-m3u8": "github:AmandaDiscord/twitch-m3u8#ba927b26fb3c5cb118d75c20f990c5cce8a1ae7a",
		"uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js.git#v20.70.0",
		"volcano-encoding": "1.0.0",
		"volcano-sdk": "2.0.0",
		"yaml": "^2.9.1",
		"ytmusic-api": "^5.3.1"
	},
	"devDependencies": {
		"lavalink-types": "3.1.0"
	},
	"files": [
		"./dist",
		"./plugins",
		"./LICENSE",
		"./README.md"
	]
}
